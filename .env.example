SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-backend-only
SUPABASE_ANON_KEY=your-anon-or-publishable-key-for-browser

# Required for login cookies
JWT_SECRET=change-this-long-random-secret

# Default user (optional)
VIORA_USER_ID=11111111-1111-1111-1111-111111111111

# Optional
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_VISION_MODEL=claude-haiku-4-5-20251001
HF_TOKEN=hf_your-token
HF_ZERO_SHOT_MODEL=openai/clip-vit-base-patch32
HF_IMAGE_CLASSIFICATION_MODEL=microsoft/resnet-50
VIORA_PHOTO_VERIFY_PROVIDER=auto
VIORA_PHOTO_VERIFY_DEMO=false
PLACES365_GYM_THRESHOLD=0.045
